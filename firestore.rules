rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /parties/{partyId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /transactions/{txnId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /publicViews/{token} {
      // Public customer links intentionally remain publicly readable.
      allow read: if true;

      // Only the business owner stored in the public view may create/update it.
      allow create, update: if request.auth != null
        && request.resource.data.businessUid == request.auth.uid;

      // Only the owning business may delete its public view.
      allow delete: if request.auth != null
        && resource.data.businessUid == request.auth.uid;
    }
  }
}
