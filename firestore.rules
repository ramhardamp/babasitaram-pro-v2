rules_version = '2';

// BSR PRO Digital Khata - schema-aware rules (docs/firestore-rules.md).
// Backward compatible: sirf zaroori fields validate hote hain (hasOnly nahi), taaki purane documents / purana app lockout na ho.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isMoney(v) { return v is number && v > 0 && v <= 1000000000; }
    function isShortString(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function validToken(t) { return t is string && t.matches('[A-Za-z0-9]{20,64}'); }

    /* ---------------- users/{uid} ---------------- */
    match /users/{userId} {
      allow read: if isOwner(userId);
      // signup / profile backfill: uid, agar bheja ho, apna hi hona chahiye
      allow create: if isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      // uid aur email-UID link badla nahi ja sakta
      allow update: if isOwner(userId)
        && (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid);
      allow delete: if false;

      /* ---------------- device push tokens (owner-only) ---------------- */
      match /pushTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      /* ---------------- parties (customers) ---------------- */
      match /parties/{partyId} {
        function validParty() {
          return isShortString(request.resource.data.name, 200)
            && request.resource.data.balance is number
            && (!('viewToken' in request.resource.data) || validToken(request.resource.data.viewToken));
        }
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validParty();
        allow update: if isOwner(userId) && validParty();
        // ✅ FIX: delete sirf owner kar sakta hai (isSignedIn nahi, isOwner hai)
        allow delete: if isOwner(userId);
      }

      /* ---------------- transactions (ledger) ---------------- */
      match /transactions/{txnId} {
        function validMoneyFields(d) {
          return d.type == 'byaj_loan'
            ? (isMoney(d.principal) && d.rate is number && d.rate >= 0 && d.rate <= 1000
               && d.get('interestPaid', 0) is number && d.get('interestPaid', 0) >= 0
               && d.get('repayments', []) is list)
            : isMoney(d.amount);
        }
        // Update par: field ya to badla nahi (purana/legacy value chalega) ya naya value valid hona chahiye
        function unchanged(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
        function validMoneyUpdate(d) {
          return d.type == 'byaj_loan'
            ? ((unchanged('principal') || isMoney(d.principal))
               && (unchanged('rate') || (d.rate is number && d.rate >= 0 && d.rate <= 1000))
               && (unchanged('interestPaid') || (d.get('interestPaid', 0) is number && d.get('interestPaid', 0) >= 0))
               && (unchanged('repayments') || d.get('repayments', []) is list))
            : (unchanged('amount') || isMoney(d.amount));
        }
        function validLoanLink(d) {
          return !(d.type in ['loan_repay', 'interest_paid']) || isShortString(d.get('loanId', null), 128);
        }
        function validStatus(d) { return d.get('status', 'active') in ['active', 'closed', 'deleted']; }

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isShortString(request.resource.data.partyId, 128)
          && request.resource.data.type in ['udhaar', 'jama', 'byaj_loan', 'loan_repay', 'interest_paid']
          && validMoneyFields(request.resource.data)
          && validLoanLink(request.resource.data)
          && validStatus(request.resource.data)
          && request.resource.data.get('status', 'active') != 'deleted'
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/parties/$(request.resource.data.partyId));

        // partyId / type / loanId / createdAt immutable; deleted record wapas nahi khulta; soft-delete mein deletedBy = apna uid
        allow update: if isOwner(userId)
          && request.resource.data.partyId == resource.data.partyId
          && request.resource.data.type == resource.data.type
          && request.resource.data.get('loanId', null) == resource.data.get('loanId', null)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && resource.data.get('status', 'active') != 'deleted'
          && validMoneyUpdate(request.resource.data)
          && (unchanged('status') || validStatus(request.resource.data))
          && (request.resource.data.get('status', 'active') != 'deleted'
              || request.resource.data.get('deletedBy', null) == userId);

        // Financial history hard-delete nahi hoti (soft delete = status 'deleted')
        allow delete: if false;
      }
    }

    /* ---------------- publicViews/{token} (customer portal) ---------------- */
    match /publicViews/{token} {
      function ownsView() { return signedIn() && resource.data.businessUid == request.auth.uid; }
      function viewLive() {
        return (!('revokedAt' in resource.data) || resource.data.revokedAt == null)
          && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || resource.data.expiresAt > request.time);
      }

      // Token-by-token read; list/enumeration band. Revoked/expired link sirf owner ko dikhta hai.
      allow get: if validToken(token) && (viewLive() || ownsView());
      allow list: if false;

      allow create: if signedIn()
        && validToken(token)
        && request.resource.data.businessUid == request.auth.uid
        && isShortString(request.resource.data.partyId, 128)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/parties/$(request.resource.data.partyId));

      // Purana owner AUR naya owner dono validate; partyId / createdAt immutable
      allow update: if ownsView()
        && request.resource.data.businessUid == request.auth.uid
        && request.resource.data.partyId == resource.data.partyId
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

      allow delete: if ownsView();
    }

    // Baaki sab kuch band
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
